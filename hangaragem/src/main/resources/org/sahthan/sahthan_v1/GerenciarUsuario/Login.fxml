<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.sahthan.sahthan_v1.controller.usuario.LoginController">

    <children>

        <VBox alignment="CENTER"
              spacing="12"
              maxWidth="300"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <!-- Logo -->
            <ImageView fitHeight="140"
                       preserveRatio="true">

                <image>
                    <Image url="@imagens/logo.png"/>
                </image>

            </ImageView>

            <!-- Subtítulo -->
            <Label text="Sistema de Gerenciamento de Hangares"
                   style="-fx-font-size: 14px;"/>

            <!-- Campos -->
            <TextField fx:id="txtEmail"
                       promptText="Email"
                       maxWidth="250"/>

            <PasswordField fx:id="txtSenha"
                           promptText="Senha"
                           maxWidth="250"/>

            <!-- Login -->
            <Button text="Entrar"
                    maxWidth="250"
                    prefWidth="250"
                    onAction="#onEntrar"/>

            <!-- Cadastro -->
            <Hyperlink text="Criar uma conta"
                       onAction="#irParaCadastro"/>

        </VBox>

    </children>

</AnchorPane>