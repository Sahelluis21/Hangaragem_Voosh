<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.sahthan.sahthan_v1.controller.usuario.LoginController">

    <children>

        <VBox spacing="10"
              layoutX="100"
              layoutY="80">

            <Label text="Login"/>

            <TextField fx:id="txtEmail" promptText="Email"/>

            <PasswordField fx:id="txtSenha" promptText="Senha"/>

            <Button text="Entrar"
                    onAction="#onEntrar"/>

            <Button text="Criar conta"
                    onAction="#irParaCadastro"/>

        </VBox>

    </children>

</AnchorPane>