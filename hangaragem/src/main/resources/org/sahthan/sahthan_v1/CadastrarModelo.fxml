<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.sahthan.sahthan_v1.controller.ModeloController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Cadastro de Modelo de Aeronave">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
        </columnConstraints>

        <children>
            <Label text="Nome:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtNome" promptText="Ex: Boeing 737" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Fabricante:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtFabricante" promptText="Ex: Boeing" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Comprimento (m):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtComprimento" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Largura (m):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="txtLargura" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Altura (m):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="txtAltura" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Peso Médio (kg):" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <TextField fx:id="txtPesoMedio" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="5" />
        </children>
    </GridPane>

    <HBox alignment="CENTER" spacing="15.0">
        <Button onAction="#onSalvar" prefWidth="100.0" text="Salvar" style="-fx-base: #2ecc71;" />
        <Button onAction="#onLimpar" prefWidth="100.0" text="Limpar" />
    </HBox>
</VBox>